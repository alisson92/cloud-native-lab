# --- Windows/WSL artifacts ---
# Alternate Data Stream created by Windows Explorer when downloading/copying
# files (shows up on any file touched via WSL <-> Windows)
*:Zone.Identifier

# --- Editors / IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Operating system ---
.DS_Store
Thumbs.db
desktop.ini

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# .terraform.lock.hcl is NOT ignored: it must be versioned (guarantees
# reproducible providers across machines/CI)
*.tfvars
*.tfvars.json
*.tfbackend

# --- Secrets / environment variables ---
.env
.env.*
!.env.example
*.pem
*.key

# --- scripts/bootstrap-vault.sh local password cache ---
# Generated Postgres/Redis passwords, cached locally so re-running the
# bootstrap after a Vault dev-mode restart is idempotent instead of
# rotating credentials already-running workloads still expect. Never
# committed — see scripts/bootstrap-vault.sh's header comment.
.vault-bootstrap-cache/

# --- Python (Airflow DAGs, automation, scripts) ---
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/

# --- Node/JS (frontend, BFF) ---
node_modules/
npm-debug.log*
yarn-error.log*
dist/
build/

# --- Claude Code (local user config) ---
.claude/settings.local.json
# Isolated worktrees created by the Agent tool (isolation: "worktree") for
# each subagent — local execution state, never project content
.claude/worktrees/

# --- "remember" plugin (local session memory state) ---
.remember/

# --- Generic logs and temporary files ---
*.log
*.tmp
*.bak
